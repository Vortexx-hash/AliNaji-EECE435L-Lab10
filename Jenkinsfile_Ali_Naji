// Use the virtual environment directly; activation does not persist across steps.
def runPython(String arguments) {
    def command = "\"${env.PYTHON_RUN}\" ${arguments}"
    if (isUnix()) {
        sh command
    } else {
        bat "@${command}"
    }
}

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        string(name: 'PYTHON_EXECUTABLE', defaultValue: 'python',
               description: 'Python 3.10+ executable available to the Jenkins service account. An absolute path is allowed; omit surrounding quotes.')
    }

    environment {
        VIRTUAL_ENV = 'venv'
        PIP_DISABLE_PIP_VERSION_CHECK = '1'
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    env.PYTHON_RUN = isUnix() ? 'venv/bin/python' : 'venv\\Scripts\\python.exe'
                    withEnv(["PYTHON_BOOTSTRAP=${params.PYTHON_EXECUTABLE}"]) {
                        if (isUnix()) {
                            sh '"$PYTHON_BOOTSTRAP" -m venv venv'
                        } else {
                            bat '@"%PYTHON_BOOTSTRAP%" -m venv venv'
                        }
                    }
                    runPython('-m pip install -r requirements.txt')
                    runPython('-c "from pathlib import Path; Path(\'reports\').mkdir(exist_ok=True)"')
                }
            }
        }

        stage('Lint') {
            steps {
                script { runPython('-m flake8 app.py deploy.py tests') }
            }
        }

        stage('Test') {
            steps {
                script { runPython('-m pytest -v --junitxml=reports/tests.xml') }
            }
        }

        stage('Coverage') {
            steps {
                script {
                    runPython('-m coverage run --branch --source=app -m pytest -v')
                    runPython('-m coverage xml -o reports/coverage.xml')
                    runPython('-m coverage html -d reports/htmlcov')
                    runPython('-m coverage report -m > reports/coverage.txt')
                    runPython('-m coverage report -m --fail-under=100')
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    // Bandit keeps its nonzero exit code when it finds a problem.
                    runPython('-m bandit app.py deploy.py -f json -o reports/bandit.json')
                    runPython('-m bandit app.py deploy.py -f txt -o reports/bandit.txt')
                }
            }
        }

        stage('Deploy') {
            steps {
                script { runPython('deploy.py') }
            }
        }
    }

    post {
        always {
            script {
                try {
                    junit testResults: 'reports/tests.xml', allowEmptyResults: true
                    archiveArtifacts artifacts: 'reports/**/*,dist/*.zip',
                                     allowEmptyArchive: true, fingerprint: true
                } finally {
                    // The versioned deployment lives outside this directory.
                    deleteDir()
                }
            }
        }
        success {
            echo 'All checks passed and the local deployment smoke test passed.'
        }
        failure {
            echo 'Pipeline failed. Open Console Output and inspect the failed stage.'
        }
    }
}
